VAR shakeCamera = false
VAR speaker = "Bullies"

~ speaker = "Bullies"
"Finally Humphrey, give us our ice cream!"
~ speaker = "Nerd"
"Y-you liars!  You guys said the path was harmless"
~ speaker = "Bullies"
"Well..."
"Seems like you got us the wrong ice cream"
"We'll give you a second chance though"

~ speaker = "Default"
 ~ shakeCamera = true
\*shove\*
~ speaker = "Bullies"
"Now bring us some popsicles instead!"