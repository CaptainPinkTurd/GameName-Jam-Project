VAR shakeCamera = false
VAR speaker = "Bullies"

~ speaker = "Bullies"
"Hey Humphrey, go get us some ice cream!"
~ speaker = "Nerd"
"But...isn't the beach dangerous right now? That's why we have to stay at the cabin.."
~ speaker = "Bullies"
"The teachers are lying to you..the beach is safe! We made sure of it..."
~ speaker = "Default"
 ~ shakeCamera = true
